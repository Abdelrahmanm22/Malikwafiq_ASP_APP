**/obj/

# Rider-specific files (also good to ignore)
.idea/
*.sln.iml
*.csproj.user
*.suo

# Visual Studio / Rider temp files
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rchive/
bld/
[Bb]in/
[Oo]bj/

# .NET User Secrets & local settings
appsettings.*.json
secrets.json

# Rider/Resharper caches (optional)
*.DotSettings.user
_ReSharper*/
*.resharper