@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
	Layout = "~/Areas/Dashboard/Views/Shared/_AuthLayout.cshtml";
}

<div asp-validation-summary="All" class="text-danger">
</div>
<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="Register" method="post">
			<input type="text" class="text" asp-for="FName" placeholder="Your First Name" />
			<span asp-validation-for="FName" class="text-danger"></span> <br />

			<input type="text" class="text" asp-for="LName" placeholder="Your Last Name" />
			<span asp-validation-for="LName" class="text-danger"></span> <br />

			<input type="email" class="text email" asp-for="Email" placeholder="Email" />
			<span asp-validation-for="Email" class="text-danger"></span> <br />

			<input type="password" class="text" asp-for="Password" placeholder="Password" />
			<span asp-validation-for="Password" class="text-danger"></span> <br />

			<input type="password" class="text" asp-for="ConfirmPassword" placeholder="Confirm Password" />
			<span asp-validation-for="ConfirmPassword" class="text-danger"></span> <br />

			<div class="wthree-text">
				<label class="anim">
					<input asp-for="IsAgree" class="checkbox" />
					<span>I Agree To The Terms & Conditions</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNUP">
		</form>
		<p>Don't have an Account? <a asp-action="Login"> Login Now!</a></p>
	</div>
</div>

@section ValidationScript {
	<partial name="_ValidationScriptsPartial" />
}