@model BookWithSectionsViewModel
@{
    ViewData["Title"] = "Sections";
    Layout = "~/Areas/Front/Views/Shared/_Layout.cshtml";
}
<div class="videos-books">
    <div class="maintitle">
        <h1>ابواب كتاب صحيح البخاري</h1>
    </div>
    <div class="book-sections">
        @foreach (var sec in Model.Sections)
        {
            <dropdown-menu class="dropdown-menu" data-name="@sec.Title">
                @foreach (var video in sec.Videos)
                {
                    <li>
                        <a asp-action="Watch" asp-controller="Video" asp-route-videoId="@video.Id">
                            @video.Title
                        </a>
                    </li>
                }
            </dropdown-menu>
        }
    </div>
</div>
@section Scripts {
    <script src="~/front/dist/js/dropdown-menu-dist.js"></script>
}