@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "ForgetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div asp-validation-summary="All" class="text-danger">
</div>
<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="SendEmail" method="post">
			<input class="email" asp-for="Email" placeholder="Email" />
			<span asp-validation-for="Email" class="text-danger"></span><br />


			<input type="submit" value="ResetPassword" />
		</form>
	</div>
</div>
@section ValidationScript {
	<partial name="_ValidationScriptsPartial" />
}